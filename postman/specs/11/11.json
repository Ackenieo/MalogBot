{
  "swagger": "2.0",
  "info": {
    "title": "11",
    "description": "MalogBot 后端接口集合 — 基于 RAG 和智能 Agent 的知识管理助手\n\n包含以下模块：\n- 会话管理\n- 对话接口（流式/非流式）\n- 命令确认机制\n- 任务继续执行\n- 联网搜索控制\n- 知识库管理\n- 多Agent团队协作\n- 监控指标",
    "version": "1.0.0"
  },
  "paths": {
    "/sessions": {
      "get": {
        "summary": "获取所有会话列表",
        "description": "获取所有会话列表，返回 sessions 列表和 current_session_id",
        "consumes": [
          "application/json"
        ],
        "responses": {},
        "tags": [
          "01-会话管理"
        ]
      }
    },
    "/sessions/new": {
      "post": {
        "summary": "创建新会话",
        "description": "创建新会话，返回 status, session_id, message",
        "consumes": [
          "application/json"
        ],
        "responses": {},
        "tags": [
          "01-会话管理"
        ]
      }
    },
    "/sessions/{session_id}": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "type": "string",
          "required": true
        }
      ],
      "delete": {
        "summary": "删除会话",
        "description": "删除指定会话，返回 status, message",
